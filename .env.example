# MetaCare Evidence service. Copy to .env for local runs; never commit .env.
# Claude key. CLAUDE_API_KEY is what the other MetaCare services use;
# ANTHROPIC_API_KEY is also accepted.
CLAUDE_API_KEY=
# Optional. Free from NCBI; raises the E-utilities limit from 3 to 10 requests a second.
NCBI_API_KEY=
# Required by NCBI etiquette so they can contact us about problem traffic.
ENTREZ_EMAIL=info@metacare.ai
# Comma separated browser origins allowed to call this service.
ALLOWED_ORIGINS=https://metacare.ai,https://www.metacare.ai,http://localhost:3000
# Claude model for PICO extraction and synthesis.
EVIDENCE_MODEL=claude-opus-5-5
# Whole request budget in seconds; partial results or 504 after this.
REQUEST_DEADLINE_SECONDS=90
PORT=8080
